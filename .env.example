# 从 @BotFather 获取
BOT_TOKEN=

# 可选多供应商模型池：复制 ai-providers.example.json 后修改，每次请求重新读取，无需重启
# Docker 中可 docker compose cp ai-providers.json tg-ai-bot:/app/data/ai-providers.json
# 然后设置 AI_PROVIDERS_FILE=/app/data/ai-providers.json；配置文件替代下面的主备配置
AI_PROVIDERS_FILE=
# 留空：JSON 配置默认 round_robin，旧主备配置默认 failover
AI_POOL_STRATEGY=
AI_MAX_ATTEMPTS=6
AI_TOTAL_TIMEOUT_MS=90000
AI_FAILURE_COOLDOWN_MS=60000
AI_MAX_REPLY_CHARS=800

# OpenCode CLI：可单独使用，不需要 AI_API_KEY；免费模型动态发现并自动尝试切换
OPENCODE_ENABLED=false
OPENCODE_AUTO_INSTALL=false
OPENCODE_VERSION=2.2.6
# 留空自动发现免费模型；也可填写多个 provider/model，用英文逗号分隔
OPENCODE_MODELS=
OPENCODE_REQUEST_TIMEOUT_MS=40000
OPENCODE_MAX_ATTEMPTS=3
OPENCODE_MODEL_CACHE_MS=3600000
# 随机器人预启动并常驻；健康检查失败或进程退出后自动重启
OPENCODE_STARTUP_TIMEOUT_MS=30000
OPENCODE_HEALTH_INTERVAL_MS=30000
# 逐模型实测使用的单模型超时（npm run opencode:probe）
OPENCODE_PROBE_TIMEOUT_MS=30000
# 已有可执行文件时可填写绝对路径
OPENCODE_BIN=
# 默认独立配置；复用当前系统用户已有的 OpenCode 配置时改为 false
OPENCODE_ISOLATED=true
# 部署后真实生成测试的模型（可带 #high 档位）
OPENCODE_SMOKE_MODEL=opencode/deepseek-v4.1-flash-free#high
# 管理员确认的当前 Topic 记忆保留天数
MEMORY_TTL_DAYS=30

# AI 接口配置：支持 OpenAI 兼容格式的中转站 / Groq / OpenAI
# chat_completions：大多数 OpenAI 兼容中转站使用这个
# responses：Codex CLI 里 wire_api = "responses" 时使用这个
AI_API_TYPE=chat_completions
AI_BASE_URL=https://api.groq.com/openai/v1
AI_API_KEY=
AI_MODEL=llama-3.3-70b-versatile
# 随机插话、冷场复活可以单独指定更便宜的模型；留空则使用 AI_MODEL
AI_MODEL_RANDOM=
AI_MODEL_IDLE=
AI_DISABLE_RESPONSE_STORAGE=true
AI_CHAT_TOKEN_FIELD=max_tokens
# 可选备用 OpenAI 兼容接口；主接口 429/5xx 时自动切换
AI_FALLBACK_API_TYPE=chat_completions
AI_FALLBACK_BASE_URL=
AI_FALLBACK_API_KEY=
AI_FALLBACK_MODEL=

# 省钱配置：限制每次请求带多少上下文和最多输出多少 token
AI_MAX_CONTEXT_MESSAGES=24
AI_MAX_INPUT_CHARS=6000
AI_MAX_MESSAGE_CHARS=600
AI_MAX_OUTPUT_TOKENS=600
# AI 请求超时（毫秒），防止接口长时间无响应卡住机器人
AI_REQUEST_TIMEOUT_MS=30000
# AI 响应体最大字节数，防止异常兼容接口返回超大正文
AI_RESPONSE_MAX_BYTES=1048576

# 多模态功能默认关闭，按所用模型和接口能力开启
VISION_ENABLED=false
VISION_MAX_BYTES=5242880
TRANSCRIPTION_ENABLED=false
TRANSCRIPTION_BASE_URL=
TRANSCRIPTION_API_KEY=
TRANSCRIPTION_MODEL=whisper-1
TRANSCRIPTION_LANGUAGE=zh
TRANSCRIPTION_MAX_BYTES=20971520
TRANSCRIPTION_RESPONSE_MAX_BYTES=1048576
TRANSCRIPTION_TIMEOUT_MS=60000
LINK_PREVIEW_ENABLED=false
LINK_PREVIEW_MAX_BYTES=524288
LINK_PREVIEW_TIMEOUT_MS=10000

# TTS：先在群里使用 /voice_on 开启；edge 免费，openai 使用兼容 /audio/speech
TTS_ENABLED=false
TTS_PROVIDER=edge
TTS_EDGE_VOICE=zh-CN-XiaoxiaoNeural
TTS_OPENAI_VOICE=alloy
TTS_MODEL=gpt-4o-mini-tts
TTS_BASE_URL=
TTS_API_KEY=
TTS_RESPONSE_FORMAT=mp3
TTS_REPLY_CHANCE=1
TTS_TIMEOUT_MS=30000
TTS_MAX_BYTES=10485760
TTS_SPEED=1

# 安全限制：只允许这些群使用机器人，多个群 ID 用英文逗号分隔；留空则不限制
# 在群里发送 /chat_id 可以查看当前群 ID
ALLOWED_CHAT_IDS=

# 手动管理员白名单，多个用户 ID 用英文逗号分隔；在群里发送 /my_id 可以查看自己的用户 ID
ADMIN_USER_IDS=

# 如果你的中转站给的是完整接口地址，也可以不用 AI_BASE_URL，直接填：
# AI_API_URL=https://example.com/v1/chat/completions

# 贴纸配置：可在群里回复贴纸发送 /sticker_add 添加到当前群贴纸池
# STICKER_IDS 是全局贴纸池，多个 file_id 用英文逗号分隔；STICKER_REPLY_CHANCE 是 AI 想发贴纸时实际发送概率
STICKER_IDS=
STICKER_REPLY_CHANCE=0.15
DATA_DIR=/app/data
DATABASE_PATH=/app/data/bot.db
MESSAGE_TTL_HOURS=24
USAGE_TTL_DAYS=30
MAINTENANCE_INTERVAL_MINUTES=60
SHUTDOWN_DRAIN_TIMEOUT_MS=15000
TZ=Asia/Shanghai

# 留空则使用 src/persona.js 中的默认人设
PERSONA_PROMPT=

# 互动方式与规则扩展
REACTION_ENABLED=true
RULE_COOLDOWN_SECONDS=60
QUIET_HOURS_START=
QUIET_HOURS_END=

# 普通消息中随机插话的概率 (0-1)
RANDOM_REPLY_CHANCE=0.05

# 两次"主动"发言之间最少间隔多少秒
MIN_REPLY_INTERVAL_SECONDS=60

# 距离上次发言至少要再过多少条群消息才会考虑再次随机插话
MIN_MSGS_BETWEEN_REPLIES=3

# 群里冷场超过多少分钟后考虑主动发话复活气氛
IDLE_THRESHOLD_MINUTES=20

# 两次冷场复活发言之间最少间隔多少分钟，防止刷屏
IDLE_COOLDOWN_MINUTES=60

# 每个群最多缓存多少条历史消息作为上下文
MAX_HISTORY=40

# 自然对话：同一人连发文字先收齐，最多等待 3 秒；0 表示关闭等待
CONVERSATION_DEBOUNCE_MS=900
# 刚被机器人回应的人，在此时间内继续说话可自然接话；0 关闭
CONVERSATION_FOLLOWUP_SECONDS=120
# 可直接叫的昵称，英文逗号分隔；仅识别句首称呼，留空只使用 @ / 回复
BOT_ALIASES=
# 自动借鉴当前群/Topic 的表达；关闭后也不再使用已经学到的表达
EXPRESSION_LEARNING_ENABLED=true
EXPRESSION_TTL_DAYS=30
